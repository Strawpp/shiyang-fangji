  "classes": {
    "warm_dry": {
      "label": "温燥助阳",
      "audiences": ["yin_xu", "re_zheng", "gao_xue_ya", "jia_kang", "shi_mian", "bian_mi"],
      "text": "温燥助阳之品，阴虚火旺、潮热盗汗、舌红少苔者不宜；高血压、甲亢、失眠、便秘者慎；外感发热期间停用。此类方多有类激素样作用，连服不宜超过 2 周。"
    },
    "rich": {
      "label": "滋腻碍胃",
      "audiences": ["pi_xu", "shi_re"],
      "text": "滋腻之品，脾胃虚寒、食少便溏、湿盛腹胀者慎用，久服易碍胃；宜少量久炖，饭后温服。"
    },
    "astringent": {
      "label": "收涩固摄",
      "audiences": ["shi_re", "re_zheng"],
      "text": "收涩固摄之品，湿热未清或外感初期不宜单用，恐闭门留寇；须待邪去后再用。"
    },
    "blood_move": {
      "label": "活血行血",
      "audiences": ["yun_fu", "chu_xue"],
      "text": "活血之品，孕期禁用；有出血倾向、月经量多或正在服用抗凝、抗血小板药物者慎用。"
    },
    "qi_tonic": {
      "label": "补气助火",
      "audiences": ["re_zheng", "shi_re"],
      "text": "补气之品，实热、湿热壅盛、血压偏高者不宜过量；服人参类期间忌浓茶与萝卜，且不宜与藜芦、五灵脂同用。"
    },
    "animal": {
      "label": "动物药与生殖器",
      "audiences": ["er_tong", "ji_su_zhong_liu", "gan_shen"],
      "text": "动物药或动物生殖器，来源与检疫难以自控，且激素样作用不明；儿童青少年、激素相关肿瘤病史者不宜；肝肾功能不全者慎。"
    },
    "organ": {
      "label": "内脏与浓汤",
      "audiences": ["tong_feng", "gan_shen"],
      "text": "动物内脏与久炖浓汤嘌呤、胆固醇偏高；高尿酸、痛风、高血脂者少用。"
    },
    "toxic": {
      "label": "毒性或峻烈药",
      "audiences": ["yun_fu", "er_tong", "gan_shen"],
      "text": "含毒性或峻烈药材，必须经炮制并严格控制煎法用量（如附子须先煎 30–60 分钟至口尝无麻感）；不可自行采买配制，须凭医师处方。"
    },
    "wine": {
      "label": "含酒精",
      "audiences": ["yun_fu", "er_tong", "gan_shen", "gao_xue_ya"],
      "text": "以酒为溶媒或含较多酒精，肝病、高血压、孕期、儿童及服药者不宜；忌与头孢类、镇静催眠药同用。"
